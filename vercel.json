    {
      "source": "/uploads/:path*",
      "destination": "http://187.52.116.85/uploads/:path*"
    },
    {
      "source": "/tat-ca-san-pham/:parent/:child",
      "destination": "/tat-ca-san-pham"
    },
    {
      "source": "/tat-ca-san-pham/:slug(.*-[0-9]+)",
