    },
    {
      "source": "/tat-ca-san-pham/:parent",
      "destination": "/tat-ca-san-pham"
    },
    {
      "source": "/chia-se/:slug",
      "destination": "/vi/chia-se/:slug"
    },
    {
      "source": "/danh-sach-san-pham",
      "destination": "/vi/danh-sach-san-pham"
    },
    {
      "source": "/danh-sach-san-pham/",
      "destination": "/vi/danh-sach-san-pham"
    },
    {
      "source": "/danh-sach-san-pham/trang-:n",
      "destination": "/vi/danh-sach-san-pham/trang-:n"
    },
    {
      "source": "/danh-sach-shop/trang-:n",
      "destination": "/vi/danh-sach-shop/trang-:n"
    },
    {
      "source": "/danh-sach-shop/",
      "destination": "/vi/danh-sach-shop"
