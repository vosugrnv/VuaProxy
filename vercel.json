    },
    {
      "source": "/danh-sach-chia-se/",
      "destination": "/vi/danh-sach-chia-se"
    },
    {
      "source": "/danh-sach-chia-se",
      "destination": "/vi/danh-sach-chia-se"
    },
    {
      "source": "/tin-nhan/:peer",
      "destination": "/tin-nhan"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.vuammovn.pro"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "admin.vuammovn.pro"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "admin.vuammovn.pro"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{0,62})",
      "destination": "/shop?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "admin.vuammovn.pro"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "has": [
        {
          "type": "host",
          "value": "admin.vuammovn.pro"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
